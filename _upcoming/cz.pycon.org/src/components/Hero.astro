---
// Cream "folder" hero card. Desktop navigation tabs sit on top of it.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { menuItems, isCurrentPage } from "../data/site";

interface FullProps {
  compact?: false;
  image: ImageMetadata;
  imageAlt?: string;
  subtitle?: boolean;
  /** Pass a `status` slot for a short line above the button (e.g. a deadline) */
  button?: { label: string; href: string };
  class?: string;
}

/** A low card with just the title, for secondary pages such as legal texts */
interface CompactProps {
  compact: true;
  class?: string;
}

type Props = FullProps | CompactProps;

const props = Astro.props;
const full = props.compact ? undefined : props;
const subtitle = full?.subtitle ?? false;
const button = full?.button;
const currentPath = Astro.url.pathname;
---

<section class:list={["pc-hero pc-container", { "pc-hero--compact": props.compact }, props.class]}>
  <nav class="pc-tabs" aria-label="Main">
    {
      menuItems.map((item, index) => (
        <a
          href={item.href}
          class:list={["pc-tabs__link", { "pc-tabs__link--home": index === 0 }]}
          aria-current={isCurrentPage(item.href, currentPath) ? "page" : undefined}
          aria-label={item.shortLabel && item.label}
        >
          {item.shortLabel ? (
            <>
              <span class="pc-tabs__short">{item.shortLabel}</span>
              <span class="pc-tabs__full">{item.label}</span>
            </>
          ) : (
            item.label
          )}
        </a>
      ))
    }
  </nav>

  <div class:list={["pc-hero__card", { "pc-hero__card--no-subtitle": !subtitle }]}>
    <h1 class="pc-hero__title"><slot name="title" /></h1>
    {
      subtitle && (
        <p class="pc-hero__subtitle">
          <slot name="subtitle" />
        </p>
      )
    }
    {
      button && (
        <div class="pc-hero__action">
          {Astro.slots.has("status") && (
            <p class="pc-hero__status">
              <slot name="status" />
            </p>
          )}
          <a class="pc-btn pc-hero__button" href={button.href}>
            {button.label}
          </a>
        </div>
      )
    }
    {
      full && (
        // An explicit fallbackFormat keeps Astro from also emitting the unused original PNG
        <Picture
          src={full.image}
          formats={["avif", "webp"]}
          fallbackFormat="png"
          class="pc-hero__image"
          alt={full.imageAlt ?? ""}
          loading="eager"
          decoding="async"
        />
      )
    }
  </div>
</section>
