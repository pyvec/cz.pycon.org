---
// Cream "folder" hero card. Desktop navigation tabs sit on top of it.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { menuItems, isCurrentPage } from "../data/site";

interface Props {
  image: ImageMetadata;
  imageAlt?: string;
  subtitle?: boolean;
  /** Pass a `note` slot for a short line under the button */
  button?: { label: string; href: string };
  class?: string;
}
const { image, imageAlt = "", subtitle = false, button, class: className } = Astro.props;
const currentPath = Astro.url.pathname;
---

<section class:list={["pc-hero pc-container", className]}>
  <nav class="pc-tabs" aria-label="Main">
    {
      menuItems.map((item, index) => (
        <a
          href={item.href}
          class:list={["pc-tabs__link", { "pc-tabs__link--home": index === 0 }]}
          aria-current={isCurrentPage(item.href, currentPath) ? "page" : undefined}
          aria-label={item.shortLabel && item.label}
        >
          {item.shortLabel ? (
            <>
              <span class="pc-tabs__short">{item.shortLabel}</span>
              <span class="pc-tabs__full">{item.label}</span>
            </>
          ) : (
            item.label
          )}
        </a>
      ))
    }
  </nav>

  <div class:list={["pc-hero__card", { "pc-hero__card--no-subtitle": !subtitle }]}>
    <h1 class="pc-hero__title"><slot name="title" /></h1>
    {
      subtitle && (
        <p class="pc-hero__subtitle">
          <slot name="subtitle" />
        </p>
      )
    }
    {
      button && (
        <div class="pc-hero__action">
          <a class="pc-btn pc-hero__button" href={button.href}>
            {button.label}
          </a>
          {Astro.slots.has("note") && (
            <p class="pc-hero__note">
              <slot name="note" />
            </p>
          )}
        </div>
      )
    }
    {/* An explicit fallbackFormat keeps Astro from also emitting the unused original PNG */}
    <Picture
      src={image}
      formats={["avif", "webp"]}
      fallbackFormat="png"
      class="pc-hero__image"
      alt={imageAlt}
      loading="eager"
      decoding="async"
    />
  </div>
</section>
