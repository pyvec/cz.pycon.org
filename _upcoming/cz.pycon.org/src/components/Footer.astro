---
import SocialIcon from "./SocialIcon.astro";
import { socialLinks, pastEditions, footerGroups } from "../data/site";

const groups = footerGroups.filter((group) => group.links.length > 0);
const editions = [...pastEditions].reverse();
---

<footer class="pc-footer">
  <div class="pc-container">
    <div class="pc-footer__main">
      <div class="pc-footer__brand">
        <p class="pc-footer__logo">PyCon CZ 27</p>
        <p class="pc-footer__meta">16–18 April 2027<br />Pilsen</p>
        <p class="pc-footer__contact">
          Do you have any questions?<br />
          <a href="mailto:info@pycon.cz">Contact&nbsp;us!</a>
        </p>
        <ul class="pc-social pc-social--compact">
          {
            socialLinks.map((item) => (
              <li>
                <a class="pc-social__link" rel="me" href={item.href} title={item.shortLabel}>
                  <SocialIcon icon={item.icon} />
                  <span class="visually-hidden">{item.shortLabel}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="pc-footer__groups">
        {
          groups.map((group) => (
            <nav class="pc-footer__group" aria-label={group.label}>
              <p class="pc-footer__label" aria-hidden="true">
                {group.label}
              </p>
              <ul class="pc-footer__links">
                {group.links.map((link) => (
                  <li>
                    <a class="pc-footer__link" href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <nav class="pc-footer__editions" aria-label="Past editions">
      <p class="pc-footer__label" aria-hidden="true">Past editions</p>
      <ul class="pc-footer__chips">
        {
          editions.map((year) => (
            <li>
              <a class="pc-footer__chip" href={`/${year}/`} aria-label={`PyCon CZ ${year}`}>
                {year}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="pc-footer__legal">
      <a href="https://www.python.org/psf/trademarks/pycon/">PyCon</a>™ is a&nbsp;trademark for worldwide conference
      activities claimed by the
      <a href="https://www.python.org/psf-landing/">Python Software Foundation</a> and used with permission.
      <a href="https://pydata.org/">PyData</a> is an educational program of <a href="https://numfocus.org/">NumFOCUS</a>
    </p>
  </div>
</footer>
