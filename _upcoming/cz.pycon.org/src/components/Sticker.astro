---
// Decorative sticker (see sticker.css), served as AVIF/WebP with a PNG fallback. Lazy loading also
// skips the download below lg, where stickers are hidden. The explicit fallbackFormat keeps Astro
// from also emitting the unused original PNG.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  image: ImageMetadata;
  class: string;
}
// The rest carries the page's data-astro-cid-* attribute, so the page's scoped styles still
// position the sticker
const { image, class: className, ...attrs } = Astro.props;
---

<Picture
  src={image}
  formats={["avif", "webp"]}
  fallbackFormat="png"
  class:list={["pc-sticker", className]}
  alt=""
  {...attrs}
/>
